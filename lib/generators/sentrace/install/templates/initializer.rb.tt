Sentrace.configure do |config|
  config.enabled = ENV.fetch("SENTRACE_ENABLED", (!Rails.env.test?).to_s) == "true"

  # Native in-process Ruby backend error capture (Rack/Rails, Sidekiq, ActiveJob)
  # AND automatic same-origin public DSN resolution for `<%%= sentrace_meta_tags %>`:
  config.project_slug = ENV.fetch("SENTRACE_PROJECT_SLUG", "<%= default_project_slug %>")
  # config.breadcrumbs_logger = %i[active_support_logger http_logger]
  # config.sample_rate = 1.0
  # config.async_queue_size = 256

  # Optional explicit public DSN override (only needed for cross-origin SPAs or CDN hosts):
  # config.frontend_dsn = ENV["SENTRACE_FRONTEND_DSN"]
  config.release = ENV["APP_RELEASE"]
  # config.cors_allowed_origins = []

  config.retention_period = 30.days
  config.orphan_issue_retention_period = 7.days

  config.max_envelope_size = 1.megabyte
  config.max_stack_frames = 50
  config.max_breadcrumbs = 20

  config.redact_fields = %w[
    password
    token
    authorization
    cookie
    credit_card
  ]

  # Exempt specific non-secret telemetry keys from key-name redaction:
  # config.allow_fields = %w[token_present token_expires_in]

  # Retain specific non-secret user scalar fields alongside `user.id_hash` (internal apps):
  # config.retain_user_fields = %w[id email username name]

  # Remote `:http` entries whose URL or token env vars are unset safely report `"unconfigured"`
  # instead of failing Rails boot (`db:migrate`, `assets:precompile`, `rspec`, `console`).
  config.environments = {
    local: {
      transport: :local
    }
    # staging: {
    #   transport: :http,
    #   url: ENV["SENTRACE_STAGING_MCP_URL"],
    #   token: ENV["SENTRACE_STAGING_MCP_TOKEN"]
    # },
    # production: {
    #   transport: :http,
    #   url: ENV["SENTRACE_PRODUCTION_MCP_URL"],
    #   token: ENV["SENTRACE_PRODUCTION_MCP_TOKEN"]
    # }
  }
end
