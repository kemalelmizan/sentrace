{
  "name": "sentrace",
  "version": "0.1.0",
  "description": "Zero-dependency @sentry/browser-compatible frontend error capturing SDK for Sentrace — cohesively integrated with Ruby on Rails, Hotwire, and federated MCP.",
  "license": "MIT",
  "author": "Kemal Elmizan <kemalelmizan@gmail.com>",
  "homepage": "https://github.com/kemalelmizan/sentrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemalelmizan/sentrace.git",
    "directory": "packages/sentrace"
  },
  "bugs": {
    "url": "https://github.com/kemalelmizan/sentrace/issues"
  },
  "keywords": [
    "sentrace",
    "error-tracking",
    "rails",
    "hotwire",
    "turbo",
    "stimulus",
    "sentry",
    "sentry-browser",
    "mcp",
    "browser",
    "observability"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/sentrace.browser.js",
  "jsdelivr": "./dist/sentrace.browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/sentrace.browser.js"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
